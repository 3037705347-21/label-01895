{
  "name": "frontend-admin",
  "private": true,
  "version": "1.0.0",
  "description": "3D火柴人格斗游戏 - 基于Three.js的网页3D格斗游戏",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8081",
    "build": "./node_modules/.bin/tsc && ./node_modules/.bin/vite build",
    "preview": "vite preview --port 8081",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.18"
  }
}
